/* ==========================================================
   ON3RT RADIO SUITE
   Theme Dark — Navy / Electric Blue / Cyan
   Version 2.0

   Charte graphique commune a toute la suite.
   Vert reserve aux etats connecte / actif / RX / OK.
   Rouge reserve au TX / erreur / alarme.
   ========================================================== */

QWidget
{
    background-color: #050911;
    color: #edf2fb;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ---------------------------------------------------------- */
/* Main Window */
/* ---------------------------------------------------------- */

QMainWindow
{
    background-color: #050911;
}

/* ---------------------------------------------------------- */
/* Labels */
/* ---------------------------------------------------------- */

QLabel
{
    color: #edf2fb;
    background: transparent;
}

QLabel#Title
{
    color: #22d3ee;
    font-size: 24pt;
    font-weight: 600;
}

QLabel#Subtitle
{
    color: #8ea1c4;
    font-size: 11pt;
}

/* ---------------------------------------------------------- */
/* Buttons */
/* ---------------------------------------------------------- */

QPushButton
{
    background-color: #0f1c36;
    border: 1px solid #2c4a78;
    border-radius: 8px;

    color: #edf2fb;

    padding: 8px 14px;

    font-size: 11pt;

    min-height: 42px;
}

QPushButton:hover
{
    background-color: #3b7bf5;
    border-color: #3b7bf5;
    color: #ffffff;
}

QPushButton:pressed
{
    background-color: #2a5ed1;
}

QPushButton:disabled
{
    background-color: #10182b;
    border-color: #1a2c4d;
    color: #4f6288;
}

/* ---------------------------------------------------------- */
/* Status Bar */
/* ---------------------------------------------------------- */

QStatusBar
{
    background-color: #0a1122;

    color: #8ea1c4;

    border-top: 1px solid #1a2c4d;
}

/* ---------------------------------------------------------- */
/* Menu */
/* ---------------------------------------------------------- */

QMenuBar
{
    background-color: #0d1a32;
    border-bottom: 1px solid #1a2c4d;
}

QMenuBar::item
{
    padding: 6px 12px;
    border-radius: 5px;
}

QMenuBar::item:selected
{
    background-color: #0f1c36;
    color: #22d3ee;
}

QMenu
{
    background-color: #0d1a32;
    border: 1px solid #1a2c4d;
    padding: 4px;
}

QMenu::item
{
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected
{
    background-color: #3b7bf5;
    color: #ffffff;
}

QMenu::separator
{
    height: 1px;
    background: #1a2c4d;
    margin: 4px 8px;
}

/* ---------------------------------------------------------- */
/* GroupBox */
/* ---------------------------------------------------------- */

QGroupBox
{
    border: 1px solid #1a2c4d;
    border-radius: 8px;

    margin-top: 10px;

    padding: 8px;
}

QGroupBox::title
{
    color: #22d3ee;

    subcontrol-origin: margin;

    left: 10px;
}

/* ---------------------------------------------------------- */
/* Line Edit */
/* ---------------------------------------------------------- */

QLineEdit
{
    background-color: #0d1a32;

    border: 1px solid #1a2c4d;

    border-radius: 5px;

    padding: 5px;

    selection-background-color: #3b7bf5;
}

QLineEdit:focus
{
    border-color: #3b7bf5;
}

/* ---------------------------------------------------------- */
/* Combo */
/* ---------------------------------------------------------- */

QComboBox
{
    background-color: #0d1a32;

    border: 1px solid #1a2c4d;

    border-radius: 5px;

    padding: 5px;
}

QComboBox:hover
{
    border-color: #2c4a78;
}

QComboBox QAbstractItemView
{
    background-color: #0d1a32;
    border: 1px solid #1a2c4d;
    selection-background-color: #3b7bf5;
    selection-color: #ffffff;
}

/* ---------------------------------------------------------- */
/* Table */
/* ---------------------------------------------------------- */

QTableWidget
{
    background-color: #0a1428;

    gridline-color: #1a2c4d;

    border: 1px solid #1a2c4d;

    selection-background-color: #3b7bf5;
    selection-color: #ffffff;
}

QHeaderView::section
{
    background-color: #0d1a32;

    color: #8ea1c4;

    padding: 5px;

    border: none;
    border-bottom: 1px solid #1a2c4d;
}

/* ---------------------------------------------------------- */
/* ScrollBar */
/* ---------------------------------------------------------- */

QScrollBar:vertical
{
    background: #0a1122;

    width: 12px;

    margin: 0;
}

QScrollBar::handle:vertical
{
    background: #2c4a78;

    min-height: 24px;

    border-radius: 6px;
}

QScrollBar::handle:vertical:hover
{
    background: #3b7bf5;
}

QScrollBar:horizontal
{
    background: #0a1122;

    height: 12px;

    margin: 0;
}

QScrollBar::handle:horizontal
{
    background: #2c4a78;

    min-width: 24px;

    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover
{
    background: #3b7bf5;
}

QScrollBar::add-line, QScrollBar::sub-line
{
    height: 0;
    width: 0;
}

/* ---------------------------------------------------------- */
/* ToolTip */
/* ---------------------------------------------------------- */

QToolTip
{
    background-color: #0d1a32;
    color: #edf2fb;
    border: 1px solid #2c4a78;
    padding: 4px 8px;
}
