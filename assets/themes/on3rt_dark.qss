/* ==========================================================
   ON3RT RADIO SUITE
   Theme Dark
   Version 1.0
   ========================================================== */

QWidget
{
    background-color: #181818;
    color: #D8FFD8;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ---------------------------------------------------------- */
/* Main Window */
/* ---------------------------------------------------------- */

QMainWindow
{
    background-color: #181818;
}

/* ---------------------------------------------------------- */
/* Labels */
/* ---------------------------------------------------------- */

QLabel
{
    color: #D8FFD8;
}

QLabel#Title
{
    color: #00FF66;
    font-size: 26pt;
    font-weight: bold;
}

QLabel#Subtitle
{
    color: #7CFFAE;
    font-size: 11pt;
}

/* ---------------------------------------------------------- */
/* Buttons */
/* ---------------------------------------------------------- */

QPushButton
{
    background-color: #262626;
    border: 1px solid #00AA55;
    border-radius: 8px;

    color: #E8FFE8;

    padding: 8px;

    font-size: 11pt;

    min-height: 42px;
}

QPushButton:hover
{
    background-color: #00AA55;
    color: black;
}

QPushButton:pressed
{
    background-color: #007A3A;
}

QPushButton:disabled
{
    background-color: #404040;
    color: gray;
}

/* ---------------------------------------------------------- */
/* Status Bar */
/* ---------------------------------------------------------- */

QStatusBar
{
    background-color: #101010;

    color: #00FF66;

    border-top: 1px solid #00AA55;
}

/* ---------------------------------------------------------- */
/* Menu */
/* ---------------------------------------------------------- */

QMenuBar
{
    background-color: #202020;
}

QMenuBar::item
{
    padding: 6px 10px;
}

QMenuBar::item:selected
{
    background-color: #00AA55;
    color: black;
}

QMenu
{
    background-color: #202020;
}

QMenu::item:selected
{
    background-color: #00AA55;
    color: black;
}

/* ---------------------------------------------------------- */
/* GroupBox */
/* ---------------------------------------------------------- */

QGroupBox
{
    border: 1px solid #00AA55;
    border-radius: 6px;

    margin-top: 10px;

    padding: 8px;
}

QGroupBox::title
{
    color: #00FF66;

    subcontrol-origin: margin;

    left: 10px;
}

/* ---------------------------------------------------------- */
/* Line Edit */
/* ---------------------------------------------------------- */

QLineEdit
{
    background-color: #252525;

    border: 1px solid #555;

    border-radius: 4px;

    padding: 4px;
}

/* ---------------------------------------------------------- */
/* Combo */
/* ---------------------------------------------------------- */

QComboBox
{
    background-color: #252525;

    border: 1px solid #555;

    padding: 4px;
}

/* ---------------------------------------------------------- */
/* Table */
/* ---------------------------------------------------------- */

QTableWidget
{
    background-color: #1F1F1F;

    gridline-color: #444;

    selection-background-color: #00AA55;
}

QHeaderView::section
{
    background-color: #2B2B2B;

    color: white;

    padding: 4px;

    border: none;
}

/* ---------------------------------------------------------- */
/* ScrollBar */
/* ---------------------------------------------------------- */

QScrollBar:vertical
{
    background: #202020;

    width: 14px;
}

QScrollBar::handle:vertical
{
    background: #00AA55;

    min-height: 20px;
}

QScrollBar:horizontal
{
    background: #202020;

    height: 14px;
}

QScrollBar::handle:horizontal
{
    background: #00AA55;

    min-width: 20px;
}